// =====================================================================
// DAX measures for the "Deliveries and satisfaction - Olist" dashboard
// Home table: fact_orders (Revenue, Logistics, Rating)
//             risk_orders (Risk)
// Each measure notes its display folder and its format.
// =====================================================================

// ---------------- Folder: Revenue ----------------

// Orders in the period (2017-01 to 2018-08), any status
[Orders] =
COUNTROWS ( fact_orders )
// format: #,0

// Gross merchandise value: price + freight, excluding canceled orders
[Revenue (GMV)] =
CALCULATE (
    SUM ( fact_orders[gmv] ),
    fact_orders[delivery_status] <> "canceled"
)
// format: "R$" #,0

[Average order value] =
CALCULATE (
    AVERAGE ( fact_orders[gmv] ),
    fact_orders[delivery_status] <> "canceled"
)
// format: "R$" #,0.00

[Revenue previous month] =
CALCULATE ( [Revenue (GMV)], DATEADD ( dim_date[Date], -1, MONTH ) )
// format: "R$" #,0

[Monthly growth %] =
DIVIDE ( [Revenue (GMV)] - [Revenue previous month], [Revenue previous month] )
// format: 0.0%

// ---------------- Folder: Logistics ----------------

// Orders whose delivery outcome is known (on time, late or not delivered)
[Orders with outcome] =
CALCULATE ( COUNTROWS ( fact_orders ), NOT ISBLANK ( fact_orders[is_late] ) )
// format: #,0

[Orders not on time] =
SUM ( fact_orders[is_late] )
// format: #,0

[% on time] =
1 - DIVIDE ( [Orders not on time], [Orders with outcome] )
// format: 0.0%

[% not on time] =
DIVIDE ( [Orders not on time], [Orders with outcome] )
// format: 0.0%

[Promised days (avg)] =
CALCULATE (
    AVERAGE ( fact_orders[promised_days] ),
    NOT ISBLANK ( fact_orders[is_late] )
)
// format: 0.0

[Actual days (avg)] =
CALCULATE (
    AVERAGE ( fact_orders[actual_days] ),
    fact_orders[delivery_status] IN { "on_time", "late" }
)
// format: 0.0

[Days late (avg, late orders)] =
CALCULATE (
    AVERAGE ( fact_orders[days_vs_estimate] ),
    fact_orders[delivery_status] = "late"
)
// format: 0.0

[Average buffer (days)] =
[Promised days (avg)] - [Actual days (avg)]
// format: 0.0

// ---------------- Folder: Rating ----------------

[Average rating] =
AVERAGE ( fact_orders[review_score] )
// format: 0.00

[Reviews] =
COUNT ( fact_orders[review_score] )
// format: #,0

[Negative reviews] =
CALCULATE ( COUNT ( fact_orders[review_score] ), fact_orders[review_score] <= 2 )
// format: #,0

[% negative reviews] =
DIVIDE ( [Negative reviews], [Reviews] )
// format: 0.0%

// "Extra" negative reviews caused by delays: the ones on orders that were
// not on time minus the ones they would have at the on-time rate.
[Negative reviews from delays] =
VAR LateReviews =
    CALCULATE ( [Reviews], fact_orders[is_late] = 1 )
VAR LateNegatives =
    CALCULATE ( [Negative reviews], fact_orders[is_late] = 1 )
// Filter by status (not by is_late = 0) because in DAX a BLANK equals 0
// and canceled or in-progress orders would slip in.
VAR OnTimeRate =
    CALCULATE ( [% negative reviews], fact_orders[delivery_status] = "on_time" )
RETURN
    MAX ( 0, LateNegatives - LateReviews * OnTimeRate )
// format: #,0

// ---------------- Folder: Risk (risk_orders table) ----------------

[Orders evaluated] =
COUNTROWS ( risk_orders )
// format: #,0

[Orders flagged] =
SUM ( risk_orders[flag_high_risk] )
// format: #,0

[% orders flagged] =
DIVIDE ( [Orders flagged], [Orders evaluated] )
// format: 0.0%

[% late orders caught] =
DIVIDE (
    CALCULATE ( SUM ( risk_orders[is_late] ), risk_orders[flag_high_risk] = 1 ),
    SUM ( risk_orders[is_late] )
)
// format: 0.0%

[Alert precision] =
DIVIDE (
    CALCULATE ( SUM ( risk_orders[is_late] ), risk_orders[flag_high_risk] = 1 ),
    [Orders flagged]
)
// format: 0.0%

[Late rate (test)] =
DIVIDE ( SUM ( risk_orders[is_late] ), [Orders evaluated] )
// format: 0.0%

[Average probability] =
AVERAGE ( risk_orders[late_probability] )
// format: 0.0%

[Average buffer (ratio)] =
AVERAGE ( risk_orders[promise_ratio] )
// format: 0.00"x"
